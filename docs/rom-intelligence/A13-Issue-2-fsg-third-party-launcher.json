  "root_cause_hypotheses": [
    {
      "id": "H1",
      "name": "Default home gate",
      "description": "Third-party default launcher makes BaseRecentsImpl.mIsUseMiuiHomeAsDefaultHome false, so addFsgGestureWindow/updateFsgWindowState do not create gesture stubs.",
      "supporting_evidence": [
        "addFsgGestureWindow gates createAndAddNavStubView on mIsUseMiuiHomeAsDefaultHome",
        "updateFsgWindowState removes/clears when mIsUseMiuiHomeAsDefaultHome is false",
        "Module does not hook Utilities.getDefaultHomePackageName or mIsUseMiuiHomeAsDefaultHome"
      ],
      "opposing_evidence": [],
      "confidence": "HIGH"
    },
    {
      "id": "H2",
      "name": "REAL_FORCE_FSG_NAV_BAR not initialized",
      "description": "Field could be read before first getGlobalBoolean hook sets it. F1-R1: false is the intended fail-closed default for the hybrid (3-button) target.",
      "supporting_evidence": [
        "No explicit initialization of REAL_FORCE_FSG_NAV_BAR"
      ],
      "opposing_evidence": [
        "addFsgGestureWindow is called from BaseRecentsImpl constructor and calls getGlobalBoolean first",
        "createAndAddNavStubView is only called after addFsgGestureWindow's condition branch",
        "getAdditionalStaticField returns null -> as? Boolean ?: false is safe"
      ],
      "confidence": "LOW"
    },
    {
      "id": "H3",
      "name": "com.mi.android.globallauncher not routed",
      "description": "ProcessScope recognizes com.mi.android.globallauncher but LauncherInstaller only enables FSG for com.miui.home.",
      "supporting_evidence": [
        "ProcessScopes maps com.mi.android.globallauncher to LAUNCHER",
        "LauncherInstaller FSG guard is com.miui.home specific"
      ],
      "opposing_evidence": [
        "Issue #2 concerns default desktop change, not com.mi.android.globallauncher",
        "The feature is intended to run in com.miui.home"
      ],
      "confidence": "LOW"
    }
  ],
