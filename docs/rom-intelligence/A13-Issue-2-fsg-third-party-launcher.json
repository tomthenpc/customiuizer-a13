  "candidate_designs": [
    {
      "id": "A",
      "name": "Hook Utilities.getDefaultHomePackageName to return com.miui.home",
      "scope": "com.miui.home.launcher.common.Utilities",
      "mechanism": "after-hook with stack-frame filter for BaseRecentsImpl context",
      "pros": [
        "single choke point for many callers",
        "no field state drift"
      ],
      "cons": [
        "affects FallbackHomeCompat, isUseMiuiHomeAsDefaultHome, isUsePocoHomeAsDefaultHome, settings UI (MiuiHomeSettings.onResume, NavBarTypeContainerPreference), and elderly-mode receiver",
        "requires stack walking in a potentially warm path",
        "risks misleading settings and default-home dialogs"
      ],
      "risk": "HIGH",
      "recommended": false
    },
    {
      "id": "B",
      "name": "Hook BaseRecentsImpl.addFsgGestureWindow and setIsUseMiuiHomeAsDefaultHome",
      "scope": "com.miui.home.recents.BaseRecentsImpl",
      "mechanism": "addFsgGestureWindow after-hook sets mIsUseMiuiHomeAsDefaultHome=true and re-calls updateUseLauncherRecentsAndFsGesture/updateFsgWindowState; setIsUseMiuiHomeAsDefaultHome before-hook overrides p3 to true when controls_fsg_horiz and REAL_FORCE_FSG_NAV_BAR are true",
      "pros": [
        "localized to BaseRecentsImpl",
        "does not affect settings UI or Utilities callers",
        "preserves REAL_FORCE_FSG_NAV_BAR fail-closed behavior",
        "reuses existing updateFsgWindowState() for stub creation/removal"
      ],
      "cons": [
        "overrides default-home state",
        "writes use_gesture_version_three=true via updateUseLauncherRecentsAndFsGesture",
        "may affect Launcher Recents ownership",
        "touches foldable mIsUseMiuiHomeAsDefaultHome consumers",
        "broader than requested side/back gesture behavior"
      ],
      "risk": "HIGH",
      "recommended": false,
      "status_f1_r1": "REJECTED_UNSAFE_UNLESS_PROVEN"
    },
    {
      "id": "C",
      "name": "Hook BaseRecentsImpl.addFsgGestureWindow / updateFsgWindowState branches directly",
      "scope": "com.miui.home.recents.BaseRecentsImpl",
      "mechanism": "force the stub-creation branch even when mIsUseMiuiHomeAsDefaultHome is false",
      "pros": [
        "minimal logic change",
        "no field mutation"
      ],
      "cons": [
        "use_gesture_version_three global may remain false because updateUseLauncherRecentsAndFsGesture uses the field",
        "mIsUseMiuiHomeAsDefaultHome still false for foldable onExpand and other consumers",
        "stale field may cause later observer-driven updateFsgWindowState to remove stubs"
      ],
      "risk": "MEDIUM-HIGH",
      "recommended": false
    },
    {
      "id": "D",
      "name": "Hook OverviewComponentObserver.updateOverviewTargets to force mIsHomeAndOverviewSame=true",
      "scope": "com.miui.home.recents.OverviewComponentObserver",
      "mechanism": "override the default-home comparison and call setIsUseMiuiHomeAsDefaultHome(true) regardless",
      "pros": [
        "covers both the observer and initial update path"
      ],
      "cons": [
        "also changes mOverviewIntent category/component and home intent construction",
        "may force MIUI recents/overview when third-party launcher is default, which is not the user's intent",
        "broad lifecycle impact"
      ],
      "risk": "HIGH",
      "recommended": false
    },
    {
      "id": "E",
      "name": "Back-stub-only recovery",
      "scope": "com.miui.home.recents.BaseRecentsImpl",
      "mechanism": "addFsgGestureWindow after-hook and updateFsgWindowState after-hook call addBackStubWindow() when hybrid conditions hold, without changing mIsUseMiuiHomeAsDefaultHome",
      "pros": [
        "leaves mIsUseMiuiHomeAsDefaultHome untouched",
        "leaves Utilities.getDefaultHomePackageName untouched",
        "leaves OverviewComponentObserver untouched",
        "leaves use_gesture_version_three untouched",
        "preserves REAL_FORCE_FSG_NAV_BAR fail-closed channel",
        "recovers only back/side gesture windows in hybrid mode",
        "reuses native addBackStubWindow() and GestureStubView.showGestureStub()"
      ],
      "cons": [
        "requires two hook points (addFsgGestureWindow and updateFsgWindowState)",
        "addBackStubWindow/clearBackStubWindow clear only one pointer per run; repeated add recreates both",
        "device validation needed"
      ],
      "risk": "MEDIUM",
      "recommended": true,
      "rank": 1,
      "status_f1_r1": "SELECTED"
    }
  ],
